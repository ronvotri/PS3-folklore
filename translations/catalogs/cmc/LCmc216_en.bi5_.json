      "file_offset": 11112,
      "source": "(pant)... (pant)...",
      "source_sha256": "9349291b681b225a86ea05263766cf79cd5cc35eafff04f1c4e170bff904c0fb",
      "vi": "(thở dốc)... (thở dốc)...",
