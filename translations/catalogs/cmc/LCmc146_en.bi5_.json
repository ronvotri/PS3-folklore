    {
      "id": "cmc/en/LCmc146_en.bi5_@00003504",
      "file_offset": 13572,
      "source": " Perhaps\nI can arrange it.",
      "source_sha256": "4c3f7898f73649ca37de97d9d344ffa51d5ed3640480db4b0e8124976261a4a3",
      "vi": " Có lẽ\ntôi sắp xếp được.",
