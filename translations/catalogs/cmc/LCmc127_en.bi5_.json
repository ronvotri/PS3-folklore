    },
    {
      "id": "cmc/en/LCmc127_en.bi5_@00003178",
      "file_offset": 12664,
      "source": "You look glum.",
      "source_sha256": "da7a688190be063ab3617ce4fdd82d868daf3688048f9840969b4f1310d99fbe",
      "vi": "",
      "status": "todo",
