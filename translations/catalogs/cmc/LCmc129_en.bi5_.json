      "source": "0but I don't want you\nto dishonor yourself.",
      "source_sha256": "cafaba03349984fbe48b47b8377063ab7b7e5c5929cd134addfb289aab6283c9",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc129_en.bi5_@00003134",
