      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc129_en.bi5_@000030b0",
      "file_offset": 12464,
      "source": "You want me to\nask her?",
      "source_sha256": "08e00982652842f756a291ee55c97a888f08c438c6024bee00ca8d067d522690",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc129_en.bi5_@000030d6",
      "file_offset": 12502,
      "source": " I will. If it'll\nconvince you.",
