      "file_offset": 11247,
      "source": "8If I ever have a chance\nto drop in on this world,",
      "source_sha256": "9e9ea6f8da685f4f1148d86bf45cc247f6fca05c6668544283a86b82ce990dc3",
      "vi": "",
