    },
    {
      "id": "cmc/en/LCmc236_en.bi5_@00002b40",
      "file_offset": 11072,
      "source": "I do hope that...",
      "source_sha256": "8f549eb7888a4f491a5c2e0e5f1b3b37f709134ea43d8bd95b64ae290e47a672",
      "vi": "",
      "status": "todo",
