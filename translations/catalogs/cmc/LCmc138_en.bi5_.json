  "entries": [
    {
      "id": "cmc/en/LCmc138_en.bi5_@000041e8",
      "file_offset": 16872,
      "source": "Livane!",
      "source_sha256": "3d33b898ca8f051401165865c70bf099ff6d3c45f9f6d1400adbd33352c9639f",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc138_en.bi5_@000041f3",
      "file_offset": 16883,
      "source": ",You are a curse\nupon the Netherworld!",
      "source_sha256": "f0de899e777d730944f77ebafee0b78f28afe8c3591ce3cf664394fb3ad92ae7",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc138_en.bi5_@00004227",
      "file_offset": 16935,
      "source": "(Tsk! Up to your\nold tricks again?",
      "source_sha256": "fbe2bb3167c425e287ddb9930e61a96be8cf1778b7ed72e329ba68b4902c1ea5",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc138_en.bi5_@0000424f",
      "file_offset": 16975,
      "source": ",How many Messengers\nhave died this way?",
      "source_sha256": "82b895f59c2c0546a81b4080f17c781edae8058f1c8690822fae19fce96fa4de",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc138_en.bi5_@0000427c",
      "file_offset": 17020,
      "source": "Silence!",
      "source_sha256": "dbb971cf7eb081ef6c8eb572a917eb1e68a25411e3583cd273b6a5f4ce63df12",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc138_en.bi5_@0000428b",
      "file_offset": 17035,
      "source": "$It is all for the Netherworld!",
      "source_sha256": "b25ff96dd047090b56ee2afaf4d401d246329c5e39142d3fda57b7fdea25966e",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc138_en.bi5_@000042b8",
      "file_offset": 17080,
      "source": " Why?",
      "source_sha256": "dfda570d34bee43db970bd68bd0370c5b314ac01287cbd1b9ba810447c6bbec0",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc138_en.bi5_@000042c3",
      "file_offset": 17091,
      "source": "8Looks like there are two\nsides to this conflict.",
      "source_sha256": "e5305cfd13332ed35559579fe553a8f5b43af6165627b2b27c9c80808981c8b9",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc138_en.bi5_@000042fc",
      "file_offset": 17148,
      "source": "By the way, Ellen...",
      "source_sha256": "899226ee0bdb547a1c3b93c30af975dc0240f283ca3c0672d26ded8308d23d80",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc138_en.bi5_@0000431f",
      "file_offset": 17183,
      "source": ",He's headed for the\nSwamp of Oblivion.",
      "source_sha256": "09b49bd42bceff5e73c1dbe0af86a95c9c126be59418b1de356f6a2f08049ac9",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc138_en.bi5_@0000434c",
      "file_offset": 17228,
      "source": "The Swamp?",
      "source_sha256": "bbb33b051206c33a60eec83f67ab4d95bfe32107ecc729775b4ada6f2aa994c6",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc138_en.bi5_@0000435b",
      "file_offset": 17243,
      "source": "$You can forget about\nthe boy.",
      "source_sha256": "8c073f29462679ab5f89cae49101912828ef8cbab1fd2293f92d425946add68f",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc138_en.bi5_@0000437f",
      "file_offset": 17279,
      "source": "0The Swamp is a pit of\ngurgling nothingness.",
      "source_sha256": "613bc3b47e2fd07f87adff499cba42ae400dfa99ab81dd83235336c63a87fe65",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc138_en.bi5_@000043af",
      "file_offset": 17327,
      "source": "HHe who enters shall\nslip from existence and\nbe forgotten by all.",
      "source_sha256": "285597c796110d7f64f953cb420269dc383ed8dc2711448ea20ea1f8601f93b8",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc138_en.bi5_@000043f8",
      "file_offset": 17400,
      "source": "She's right.",
      "source_sha256": "8ca3c40994466571595bc2134cf7551cb3d14c461da039ead618d4af078f30ac",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc138_en.bi5_@00004417",
      "file_offset": 17431,
      "source": "$Ellen!\nDo not listen to him!",
      "source_sha256": "f06c5cc679d89f618275c30a73c379528a80cc52f7b685dedcfcab68f233d46c",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc138_en.bi5_@0000443c",
      "file_offset": 17468,
      "source": "The Lord, or the boy?",
      "source_sha256": "8c43e11b43c1287940fcd96daa08ba210995abecd184b2525090cb5448717d42",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc138_en.bi5_@00004457",
      "file_offset": 17495,
      "source": "$The Netherworld, or reality?",
      "source_sha256": "1307a8629304cd695c9312c788b4c66b97a4018a6b431f73ec3944fbb79d2f6b",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc138_en.bi5_@0000447b",
      "file_offset": 17531,
      "source": ",Those are awfully\ndifficult choices!",
      "source_sha256": "323d792e0bcb388f2b54631fb4fd29fa8584b46e4c67ae9c24bc9c4d9bd8c099",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc138_en.bi5_@000044af",
      "file_offset": 17583,
      "source": " But choices she must make.",
      "source_sha256": "8933253b989d33c877829e13314dbd524fe78167e374885c8258d5dcba09fc01",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc138_en.bi5_@000044d0",
      "file_offset": 17616,
      "source": "Ellen!\nYou have come.",
      "source_sha256": "5ea4bd75140b4aa492dafe21ef06555cd48dadb71cab70f121dd6695c6d2f41d",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc138_en.bi5_@000044ec",
      "file_offset": 17644,
      "source": "Herve?!?",
      "source_sha256": "6d1248dd0a9ed70369df469a4c55d7b5ee8c6183f4197676c092f4d1b5f6c961",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc138_en.bi5_@000044fc",
      "file_offset": 17660,
      "source": "Fancy meeting\nyou here.",
      "source_sha256": "21d4b58c46d058194de5be863be66d0e4f4232059347510a102004e61b489d02",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc138_en.bi5_@00004520",
      "file_offset": 17696,
      "source": "About that boy\nHerve...",
      "source_sha256": "6f0443d4b380a239ab51075cecf5a48dfb54bbd581795907bde408ffef5ceee5",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc138_en.bi5_@0000453b",
