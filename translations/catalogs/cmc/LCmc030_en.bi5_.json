    {
      "id": "cmc/en/LCmc030_en.bi5_@00002bd8",
      "file_offset": 11224,
      "source": "I just know.",
      "source_sha256": "abc2b4503251a8a9290546971f90dfbe103d80f281c1df95b8adfc29000376b8",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc030_en.bi5_@00002bf4",
      "file_offset": 11252,
