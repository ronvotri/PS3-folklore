      "notes": ""
    },
    {
      "id": "cmc/en/LCmc030_en.bi5_@00002bc0",
      "file_offset": 11200,
      "source": "How do you know?",
      "source_sha256": "07fa34e2694cb6ca6879ec76be509677224b63ff761db3dea4b6767c35d6bda9",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
