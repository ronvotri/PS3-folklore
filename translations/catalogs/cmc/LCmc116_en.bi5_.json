      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc116_en.bi5_@00002d63",
      "file_offset": 11619,
      "source": "(First Herve,\nand now Renaldo...!",
      "source_sha256": "6f70426d1d53b3388152c7c3142eeed9e207845330e318d68b3cb3e00e60560e",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc116_en.bi5_@00002d8c",
      "file_offset": 11660,
      "source": "It's her!\nShe did it!",
      "source_sha256": "9828f3c92c05bc4fb30a24cc250921b3f645aa20eac7b3245c98594aef9014c2",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc116_en.bi5_@00002da7",
      "file_offset": 11687,
      "source": " My beloved daughter,\nEllen",
      "source_sha256": "37170d936bc0f0d135d09b95dc7b6b19116fc38d6b22ad92c54c603838498d62",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc116_en.bi5_@00002dc7",
      "file_offset": 11719,
      "source": "@Forgive me for being absent\nfrom your life for 17 years.",
      "source_sha256": "80981bd0c3e44cd90c47e4532e10ff5fceda4399f41ba2aadba4ec24466ac84e",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc116_en.bi5_@00002e07",
      "file_offset": 11783,
      "source": "LI await you on November 2,\nat Samhain, on the Cliff of Sidhe, Doolin.",
      "source_sha256": "5122e958c86cef904b9730cf66cdb9adddd31996f9cb59b211ad4afac7d01058",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc116_en.bi5_@00002e54",
      "file_offset": 11860,
      "source": "Your mother.",
      "source_sha256": "9038909b4f65427c99aefa4eafe3a3b7bbe810394235364b5ddaefb298d3c100",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc116_en.bi5_@00002e70",
      "file_offset": 11888,
      "source": " Finally...\nRevenge!",
      "source_sha256": "b9dd200a0df18c46106c55cb0f2030dc4e5f7032459c31ab14a99d3be2e6655c",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc116_en.bi5_@00002e8b",
      "file_offset": 11915,
      "source": ",Herve is her son,\nRenaldo her husband.",
      "source_sha256": "01423e8e85b6a8a05e7e7da5112ff7add90b031f32d0fcd11af6399552f67c8f",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc116_en.bi5_@00002eb7",
      "file_offset": 11959,
      "source": "(17 years ago,\nshe lost them both.",
      "source_sha256": "b96a71f5fb5bce57403c7461569f959e1d974bd6c6f4e2e7a14105a6495149e1",
      "vi": "",
      "status": "todo",
      "source_review": "candidate",
      "notes": ""
    },
    {
      "id": "cmc/en/LCmc116_en.bi5_@00002edf",
