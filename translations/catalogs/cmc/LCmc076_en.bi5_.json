      "file_offset": 11260,
      "source": "I killed them all.",
      "source_sha256": "51d4efa5dab4af5ae4d8934f04fff8c9017dc9190b6fd68bb50e1af5ef10dcbc",
      "vi": "Chính tôi đã giết tất cả.",
