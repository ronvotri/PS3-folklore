    },
    {
      "id": "cmc/en/LCmc076_en.bi5_@00002ba7",
      "file_offset": 11175,
      "source": "(You hid the truth,\nfor my sake...",
      "source_sha256": "fc9713b12d69fd32d1b303c110341ec60b7bed92991ecd336cbeb40b67cd0942",
      "vi": "(Ông đã giấu sự thật,\nvì muốn bảo vệ tôi...",
