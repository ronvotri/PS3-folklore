    },
    {
      "id": "cmc/en/LCmc076_en.bi5_@00002b34",
      "file_offset": 11060,
      "source": "And gave my blood.",
      "source_sha256": "3dc477ce1b8d600e65d45d8ef819ea4a347f9f92c6ccad08f76119193d841fb3",
      "vi": "Và dâng máu của mình.",
      "status": "draft",
