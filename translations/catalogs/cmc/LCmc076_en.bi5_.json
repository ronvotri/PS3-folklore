      "file_offset": 11084,
      "source": "But he...",
      "source_sha256": "6502a05f0b81b53a8d003fd337b26e585a8b0b4e221cebd986c4fd4c8eb56292",
      "vi": "Nhưng cậu ấy...",
      "status": "draft",
      "source_review": "candidate",
      "notes": "Bản dịch nháp, chưa xác minh đầy đủ speaker/metadata và game runtime."
    },
    {
