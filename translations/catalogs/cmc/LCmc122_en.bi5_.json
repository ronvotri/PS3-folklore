      "notes": ""
    },
    {
      "id": "cmc/en/LCmc122_en.bi5_@00002ac3",
      "file_offset": 10947,
      "source": "HThe fabrications of\nancient man and these\nillusions are unrelated.",
      "source_sha256": "43721ddff0e32024b6d29d4d1644e4d2d5601b10c9b4a6d0be46049f54f41c13",
      "vi": "",
      "status": "todo",
