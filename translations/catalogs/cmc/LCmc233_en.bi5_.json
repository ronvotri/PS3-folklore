  "entries": [
    {
      "id": "cmc/en/LCmc233_en.bi5_@00003797",
      "file_offset": 14231,
      "source": "(A voice told me to give my blood.",
      "source_sha256": "932cc0efb94c682257037ba3875ff555c85023f1a0fbe8a5955776fcf65c4c43",
      "vi": "",
      "status": "todo",
